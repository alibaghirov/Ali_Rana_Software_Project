# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Telegram Bot API token for automated system monitoring alerts.
# Stored securely in server-side environment variables and NEVER committed to Git.
TELEGRAM_BOT_TOKEN="8808715727:AAEokHUNnA4uThzLdSYX56j3i6iOrk-Lv1M"

# TELEGRAM_CHAT_ID: Team Telegram channel or group chat ID to receive alerts (e.g. -1001234567890 or @channel).
# If left blank, the bot can auto-detect the latest chat via Telegram getUpdates or via the Monitoring UI.
TELEGRAM_CHAT_ID=""
